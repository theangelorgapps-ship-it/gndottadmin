{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gndottadmin",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "streamit-media"
    }
  ],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamit",
      "database_id": "e5502cd6-d9f0-49d2-b4ce-e9dffb0217d7"
    }
  ]
}
